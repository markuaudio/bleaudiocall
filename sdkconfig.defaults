CONFIG_IDF_TARGET="esp32"
# Release version printed at boot (app_init: App version) and stored in the
# binary's app descriptor; bump it for every client release.
CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
CONFIG_APP_PROJECT_VER="1.0.1"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Classic Bluetooth only (BLE memory released at boot).
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BT_BLE_ENABLED=n
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y

# Music: A2DP sink + AVRCP (play/pause, next, absolute volume).
CONFIG_BT_A2DP_ENABLE=y
CONFIG_BT_AVRCP_ENABLED=y
CONFIG_BT_A2DP_USE_EXTERNAL_CODEC=n

# Calls: HFP Hands-Free unit. Voice (SCO) travels over HCI so the firmware
# gets PCM (CVSD 8 kHz / mSBC 16 kHz) and plays it through the ES8388.
CONFIG_BT_HFP_ENABLE=y
CONFIG_BT_HFP_CLIENT_ENABLE=y
CONFIG_BT_HFP_AG_ENABLE=n
CONFIG_BT_HFP_AUDIO_DATA_PATH_HCI=y
CONFIG_BT_HFP_USE_EXTERNAL_CODEC=n
CONFIG_BT_HFP_WBS_ENABLE=y
CONFIG_BTDM_CTRL_BR_EDR_SCO_DATA_PATH_HCI=y
CONFIG_BTDM_CTRL_BR_EDR_MAX_SYNC_CONN=1
CONFIG_BTDM_CTRL_BR_EDR_MAX_ACL_CONN=2

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# ESP-IDF's brownout handler is OFF: it would reset the chip. main/power_guard.c
# programs the same brownout comparator itself (level 7 = 2.80 V, above the
# LyraT's IMP809 supervisor at 2.63 V) and its interrupt cuts the amplifier
# instead of resetting, so a weak supply costs a short mute, not the link.
CONFIG_ESP_BROWNOUT_DET=n

# Release build (final project). -O2 instead of the IDF default -Og: the audio
# task does float limiter / gain maths per sample at 44.1 kHz on core 1.
# Assertions stay on while hardware bring-up of the call path is unfinished.
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# AVRCP cover art (BIP over OBEX) is never used by a speaker: saves RAM/flash.
CONFIG_BT_AVRCP_CT_COVER_ART_ENABLED=n
